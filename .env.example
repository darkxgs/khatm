# Postgres. Without it, Khatm runs on an embedded Postgres (PGlite) in .data/.
# On Neon, use the pooled URL here and the direct one below for migrations.
# Khatm keeps its tables in their own "khatm" schema, so it can share a database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies. Any long random string; required in production.
AUTH_SECRET=

# Protects /api/cron/cleanup, which Vercel Cron calls daily to remove expired demos.
CRON_SECRET=

# The address share links point at. Defaults to the address the page was opened on.
KHATM_PUBLIC_URL=

# Salt for hashing visitor addresses in rate limits. Defaults to AUTH_SECRET.
RATE_SALT=
