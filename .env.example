# Postgres. Without it, Khatm runs on an embedded Postgres (PGlite) in .data/.
# On Neon, use the pooled URL here and the direct one below for migrations.
# Khatm keeps its tables in their own "khatm" schema, so it can share a database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies. Optional: without it, Khatm makes a random key the
# first time it needs one and keeps it in the database (khatm.app_keys).
AUTH_SECRET=

# Vercel Cron calls /api/cron/cleanup daily to remove expired demos, and sends
# this as a bearer token. Optional: without it, anyone may call the route, and it
# cleans up at most once an hour, as opening a demo already does.
CRON_SECRET=

# The address share links point at. Defaults to the address the page was opened on.
KHATM_PUBLIC_URL=

# Key for hashing visitor addresses in rate limits. Optional, like AUTH_SECRET.
RATE_SALT=
